{
  "name": "localhost/seu_projeto",
  "description": "Projeto migrado para autoload via Composer",
  "autoload": {
    "psr-4": {
      "App\\": "_app/"
    },
    "files": [
      "_app/Config/bootstrap.php"
    ]
  },
  "autoload-dev": {
    "classmap": [
    ]
  },
  "require": {
    "league/glide": "^3.0.1",
    "phpmailer/phpmailer": "^6.10",
    "vlucas/phpdotenv": "^5.6",
    "php": "^8.3",
    "ext-fileinfo": "*"
  },
  "suggest": {
    "ext-gd": "One of ext-gd or ext-imagick is required for image manipulation with Glide.",
    "ext-imagick": "One of ext-imagick or ext-gd is required for image manipulation with Glide."
  },
  "require-dev": {
    "rector/rector": "^2.1",
    "phpstan/phpstan": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpcompatibility/php-compatibility": "^9.3",
    "squizlabs/php_codesniffer": "^3.13",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpunit/phpunit": "^12.3",
    "friendsofphp/php-cs-fixer": "^3.87",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.3.0"
    }
  },
  "scripts": {
    "lint": "/opt/homebrew/opt/php@8.3/bin/php vendor/bin/parallel-lint ./_app ./_api ./admin ./themes ./_cdn/widgets ./index.php --exclude ./uploads --exclude ./vendor --exclude ./var",
    "test": "/opt/homebrew/opt/php@8.3/bin/php vendor/bin/phpunit",
    "phpcs": "/opt/homebrew/opt/php@8.3/bin/php vendor/bin/phpcs",
    "phpcbf": "/opt/homebrew/opt/php@8.3/bin/php vendor/bin/phpcbf --standard=psr12 ./_app ./_api ./admin ./themes ./_cdn",
    "phpcs:compat": "/opt/homebrew/opt/php@8.3/bin/php -d error_reporting='E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED' vendor/bin/phpcs -s -p --standard=PHPCompatibility --runtime-set testVersion 8.3- --extensions=php --ignore=vendor/*,var/*,uploads/*,_app/uploads/*,cache/* ./_app ./_api ./admin ./themes ./_cdn ./index.php",
    "cs:fixer": "/opt/homebrew/opt/php@8.3/bin/php vendor/bin/php-cs-fixer fix --allow-risky=yes",
    "phpstan": "/opt/homebrew/opt/php@8.3/bin/php -d memory_limit=1G vendor/bin/phpstan analyse -c phpstan.neon.dist",
    "stan:clear": "/opt/homebrew/opt/php@8.3/bin/php vendor/bin/phpstan clear-result-cache",
    "rector": "/opt/homebrew/opt/php@8.3/bin/php vendor/bin/rector process",
    "generate-constants-stub": "/opt/homebrew/opt/php@8.3/bin/php bin/generate-constants-stub.php"
  }
}
